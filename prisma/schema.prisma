generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Usuarios del sistema
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  role          String    @default("EMPLOYEE") // ADMIN, EMPLOYEE
  department    String?
  avatar        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relaciones
  allergies     UserAllergy[]
  preferences   UserPreference[]
  absences      Absence[]
  orders        Order[]
  notifications Notification[]
  skipMeals     SkipMeal[]
}

// Alergias/intolerancias de usuarios
model Allergy {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?
  icon        String?

  users       UserAllergy[]
  dishes      DishAllergy[]
}

model UserAllergy {
  id        String   @id @default(cuid())
  userId    String
  allergyId String
  severity  String   @default("HIGH") // LOW, MEDIUM, HIGH

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  allergy   Allergy  @relation(fields: [allergyId], references: [id], onDelete: Cascade)

  @@unique([userId, allergyId])
}

// Preferencias alimentarias
model UserPreference {
  id        String   @id @default(cuid())
  userId    String
  type      String   // VEGETARIAN, VEGAN, HALAL, KOSHER, LOW_CARB, etc.
  notes     String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

// Menús semanales/diarios
model Menu {
  id          String    @id @default(cuid())
  name        String
  description String?
  date        DateTime  // Fecha del menú
  weekNumber  Int?
  year        Int?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  dishes      MenuDish[]
  orders      Order[]
}

// Platos disponibles
model Dish {
  id          String        @id @default(cuid())
  name        String
  description String?
  category    String        // STARTER, MAIN, SIDE, DESSERT, DRINK
  price       Float         @default(0)
  calories    Int?
  image       String?
  isAvailable Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  menus       MenuDish[]
  allergies   DishAllergy[]
  orderItems  OrderItem[]
  tags        DishTag[]
}

// Relación platos-menús
model MenuDish {
  id       String @id @default(cuid())
  menuId   String
  dishId   String
  position Int    @default(0) // Orden de aparición

  menu     Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  dish     Dish   @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@unique([menuId, dishId])
}

// Alérgenos en platos
model DishAllergy {
  id        String  @id @default(cuid())
  dishId    String
  allergyId String

  dish      Dish    @relation(fields: [dishId], references: [id], onDelete: Cascade)
  allergy   Allergy @relation(fields: [allergyId], references: [id], onDelete: Cascade)

  @@unique([dishId, allergyId])
}

// Etiquetas de platos (vegetariano, picante, etc.)
model DishTag {
  id      String @id @default(cuid())
  dishId  String
  tag     String // VEGETARIAN, VEGAN, SPICY, GLUTEN_FREE, etc.

  dish    Dish   @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@unique([dishId, tag])
}

// Pedidos
model Order {
  id          String      @id @default(cuid())
  userId      String
  menuId      String
  date        DateTime    // Fecha del pedido
  status      String      @default("PENDING") // PENDING, CONFIRMED, CANCELLED, COMPLETED
  notes       String?
  totalPrice  Float       @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  menu        Menu        @relation(fields: [menuId], references: [id], onDelete: Cascade)
  items       OrderItem[]

  @@unique([userId, menuId, date])
}

// Items de pedidos
model OrderItem {
  id       String @id @default(cuid())
  orderId  String
  dishId   String
  quantity Int    @default(1)
  notes    String?

  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dish     Dish   @relation(fields: [dishId], references: [id], onDelete: Cascade)
}

// Ausencias programadas
model Absence {
  id        String   @id @default(cuid())
  userId    String
  startDate DateTime
  endDate   DateTime
  reason    String?  // VACATION, SICK, REMOTE, OTHER
  notes     String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Días que no come (sin ausencia completa)
model SkipMeal {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  meal      String   @default("LUNCH") // BREAKFAST, LUNCH, DINNER
  reason    String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, meal])
}

// Notificaciones
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   // MENU_PUBLISHED, ORDER_CONFIRMED, REMINDER, SYSTEM
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Configuración del sistema
model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
