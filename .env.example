# ===========================================
# Smart Tabula - Environment Configuration
# ===========================================
# Copy this file to .env and configure your values

# ===========================================
# DATABASE
# ===========================================
# SQLite (default - no setup required)
DATABASE_URL="file:./dev.db"

# PostgreSQL (uncomment to use with docker-compose.postgres.yml)
# DATABASE_URL="postgresql://smarttabula:smarttabula@localhost:5432/smarttabula"

# ===========================================
# AUTHENTICATION
# ===========================================
# REQUIRED: Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"

# Application URL (change in production)
NEXTAUTH_URL="http://localhost:3000"

# ===========================================
# APPLICATION
# ===========================================
# App name shown in the UI
NEXT_PUBLIC_APP_NAME="Smart Tabula"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===========================================
# ORDERING SETTINGS
# ===========================================
# Order deadline (HH:MM format, 24h) - orders blocked after this time
ORDER_DEADLINE="10:00"

# Timezone for deadline calculations
TZ="Europe/Madrid"
